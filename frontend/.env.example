# SOFRA Frontend Configuration

# URL of the Express Backend API
# In production (e.g., Render/Railway): https://sofra-backend-hvhu.onrender.com
# In local development: http://localhost:5000 (or leave blank to use Vite proxy)
VITE_API_URL=https://sofra-backend-hvhu.onrender.com

# Google OAuth Client ID (must match Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
