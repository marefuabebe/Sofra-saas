# ==============================================================================
# SOFRA Backend - Production Environment Variables Example
# ==============================================================================

# Server Configuration
NODE_ENV=production
PORT=5000

# Frontend Deployment URL (CORS & Email links)
# Multiple origins can be comma-separated: https://sofra.vercel.app,https://yourdomain.com
FRONTEND_URL=https://your-frontend.vercel.app

# MongoDB Connection String (e.g., MongoDB Atlas Replica Set)
# Replace with your actual Atlas cluster connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sofra?retryWrites=true&w=majority

# Security (JWT Auth)
# Generate a 64-char key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_character_string

# MongoDB Transactions
# Set to true when connected to MongoDB Atlas (which is a replica set by default)
MONGODB_TRANSACTIONS=true

# Google Apps Script Email Proxy (Free delivery for @gmail.com on Render)
GAS_EMAIL_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
# GAS_API_KEY=optional_secret_token

# SMTP Fallback (optional, used when GAS_EMAIL_URL is omitted)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Cloudinary (Persistent cloud storage for restaurant logos, banners, food photos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Chapa Payment Gateway (Ethiopian Birr: telebirr, CBE, cards)
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxx
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxx
CHAPA_WEBHOOK_SECRET=xxxxxxxx

# Google OAuth (Sign-in with Google)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
